+    } else if (reading->status == T3P_BARO_WAITING) {
+        M_WriteUacText(x, 68, "SAMPLING...");
+    } else if (reading->status == T3P_BARO_UNSUPPORTED) {
+        M_WriteUacText(x, 68, "SENSOR ID ERROR");
+    } else {
+        M_WriteUacText(x, 68, "READ ERROR");
+    }
